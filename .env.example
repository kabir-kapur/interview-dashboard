TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_FROM_NUMBER=
SMS_TO_NUMBER=
APP_TIMEZONE=America/Los_Angeles
# Optional: hosted PostgreSQL URL. Leave blank to use the local SQLite fallback.
DATABASE_URL=
# Required for all API routes except /api/health. Keep these deployment-only secrets.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
